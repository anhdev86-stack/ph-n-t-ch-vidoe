# Bắt buộc — key Claude (engine suy luận)
ANTHROPIC_API_KEY=sk-ant-...

# Tùy chọn — đổi model. Mặc định claude-opus-5 (mạnh nhất).
# Rẻ hơn nhiều cho vision hàng loạt: claude-sonnet-5
# MODEL=claude-sonnet-5

# Chỉ cần khi dùng whisper.cpp thay cho faster-whisper:
# WHISPER_CPP_MODEL=/path/to/ggml-small.bin

# ===== TikTok Shop Partner API (lấy list video affiliate) =====
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_ACCESS_TOKEN=          # access_token của shop đã ủy quyền (không phải app_secret)
# TTS_SHOP_CIPHER=         # để trống sẽ tự lấy qua Get Authorized Shops
# TTS_BASE_URL=https://open-api.tiktokglobalshop.com
